<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/search_main"
    android:layout_width="fill_parent"
    android:layout_height="70dp"
    android:theme="@style/AppTheme.Overlay">

    <ImageView
        android:id="@+id/background_image_improve"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_centerInParent="true"
        android:src="@drawable/combo_rounded_bg_20"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/background_image_improve_light"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_centerInParent="true"
        android:src="@drawable/combo_rounded_bg_20_light_r"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/background_image"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_centerInParent="true"
        android:src="@drawable/combo_rounder_glow_bg8_36" />

    <LinearLayout
        android:id="@+id/widget_container"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="9.0dp"
        android:paddingTop="12.0dp"
        android:paddingRight="9.0dp"
        android:paddingBottom="12.0dp">

        <ImageView
            android:id="@+id/crome2"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1.0"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/combo_crome2" />

        <ImageView
            android:id="@+id/gamini2"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginStart="5.0dip"
            android:layout_weight="1.0"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/combo_gamini2" />

        <ImageView
            android:id="@+id/youtube3"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginStart="5.0dip"
            android:layout_weight="1.0"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/combo_youtube3" />

        <ImageView
            android:id="@+id/photo3"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginStart="5.0dip"
            android:layout_weight="1.0"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/combo_photo3" />

        <ImageView
            android:id="@+id/gmail"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginStart="5.0dip"
            android:layout_weight="1.0"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/combo_gmail" />

        <ImageView
            android:id="@+id/playstore3"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_marginStart="5.0dip"
            android:layout_weight="1.0"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/combo_playstore3" />
    </LinearLayout>
</RelativeLayout>

