<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:theme="@style/AppTheme.Overlay" android:id="@+id/root_view" android:layout_width="fill_parent" android:layout_height="fill_parent" android:clipToOutline="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView android:id="@+id/background_image_improve" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="fill_parent" android:src="@drawable/rounded_bg_20_rect" android:layout_centerInParent="true" />
    <ImageView android:id="@+id/background_image_improve_light" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="fill_parent" android:src="@drawable/rounded_bg_20_rect_light" android:layout_centerInParent="true" />
    <ImageView android:id="@+id/background_image" android:layout_width="fill_parent" android:layout_height="fill_parent" android:src="@drawable/rounded_for_all" android:layout_centerInParent="true" />
    <ImageView android:id="@+id/background_border" android:layout_width="fill_parent" android:layout_height="fill_parent" android:src="@drawable/rounded_with_border" android:layout_centerInParent="true" />
    <LinearLayout android:orientation="vertical" android:padding="10.0dip" android:layout_width="fill_parent" android:layout_height="fill_parent" android:weightSum="2.0">
        <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="fill_parent" android:weightSum="2.0" android:layout_weight="1.0">
            <RelativeLayout android:id="@+id/avatar_image_bg" android:padding="5.0dip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1.0" android:layout_alignParentTop="true" android:layout_alignParentStart="true">
                <ImageView android:layout_width="fill_parent" android:layout_height="fill_parent" android:src="@drawable/gradiant_bg" android:layout_centerInParent="true" />
                <ImageView android:id="@+id/mavatar_imagessss" android:layout_width="fill_parent" android:layout_height="fill_parent" android:src="@drawable/ct_profile4" android:layout_centerInParent="true" />
                <ImageView android:id="@+id/avatar_image" android:background="@drawable/avatar_bg2" android:layout_width="fill_parent" android:layout_height="fill_parent" android:scaleType="centerCrop" android:adjustViewBounds="true" android:layout_centerInParent="true" android:clipToOutline="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/message_icon_bg" android:padding="5.0dip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1.0" android:layout_alignParentTop="true" android:layout_alignParentEnd="true">
                <ImageView android:id="@+id/message_icon2" android:layout_width="fill_parent" android:layout_height="fill_parent" android:src="@drawable/gradiant_bg" android:layout_centerInParent="true" />
                <ImageView android:id="@+id/message_icon" android:layout_width="fill_parent" android:layout_height="fill_parent" android:src="@drawable/message_icondd" android:layout_centerInParent="true" />
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="fill_parent" android:weightSum="2.0" android:layout_weight="1.0">
            <RelativeLayout android:id="@+id/call_icon_bg" android:padding="5.0dip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1.0" android:layout_alignParentBottom="true" android:layout_alignParentEnd="true">
                <ImageView android:id="@+id/call_icon2" android:layout_width="fill_parent" android:layout_height="fill_parent" android:src="@drawable/red_bg" android:layout_centerInParent="true" />
                <ImageView android:id="@+id/call_icon" android:layout_width="fill_parent" android:layout_height="fill_parent" android:src="@drawable/call_iconsss" android:layout_centerInParent="true" />
            </RelativeLayout>
            <RelativeLayout android:id="@+id/whatsapp_icon" android:padding="5.0dip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1.0" android:layout_alignParentBottom="true" android:layout_alignParentStart="true">
                <ImageView android:id="@+id/whatsapp" android:layout_width="fill_parent" android:layout_height="fill_parent" android:src="@drawable/gradiant_bg" android:layout_centerInParent="true" />
                <ImageView android:layout_width="fill_parent" android:layout_height="fill_parent" android:src="@drawable/whatsapp_ir" android:layout_centerInParent="true" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

