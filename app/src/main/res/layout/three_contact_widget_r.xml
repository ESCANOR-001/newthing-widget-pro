<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:theme="@style/AppTheme.Overlay" android:id="@+id/root_view" android:layout_width="fill_parent" android:layout_height="fill_parent" android:clipToOutline="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView android:id="@+id/background_image_improve" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="fill_parent" android:src="@drawable/rounded_bg_20_rect" android:layout_centerInParent="true" />
    <ImageView android:id="@+id/background_image_improve_light" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="fill_parent" android:src="@drawable/rounded_bg_20_rect_light" android:layout_centerInParent="true" />
    <ImageView android:id="@+id/background_image" android:layout_width="fill_parent" android:layout_height="fill_parent" android:src="@drawable/rounded_for_all" android:layout_centerInParent="true" />
    <ImageView android:id="@+id/background_border" android:layout_width="fill_parent" android:layout_height="fill_parent" android:src="@drawable/rounded_with_border" android:layout_centerInParent="true" />
    <RelativeLayout android:gravity="start|top" android:id="@+id/top_contact1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentTop="true" android:layout_alignParentStart="true">
        <ImageView android:id="@+id/name_textview1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentTop="true" />
    </RelativeLayout>
    <RelativeLayout android:id="@+id/top_contact2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:layout_alignParentStart="true">
        <ImageView android:id="@+id/name_textview2" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </RelativeLayout>
    <RelativeLayout android:id="@+id/top_contact3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:layout_alignParentStart="true">
        <ImageView android:id="@+id/name_textview3" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </RelativeLayout>
    <RelativeLayout android:id="@+id/avatar_image1bg" android:background="@drawable/gradiant_bg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentTop="true" android:layout_alignParentStart="true">
        <ImageView android:id="@+id/avatar_image1" android:background="@drawable/avatar_bg2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:adjustViewBounds="true" android:layout_centerInParent="true" android:clipToOutline="true" />
    </RelativeLayout>
    <RelativeLayout android:id="@+id/avatar_image2bg" android:background="@drawable/gradiant_bg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:layout_alignParentStart="true">
        <ImageView android:id="@+id/avatar_image2" android:background="@drawable/avatar_bg2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:adjustViewBounds="true" android:layout_centerInParent="true" android:clipToOutline="true" />
    </RelativeLayout>
    <RelativeLayout android:id="@+id/avatar_image3bg" android:background="@drawable/gradiant_bg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:layout_alignParentStart="true">
        <ImageView android:id="@+id/avatar_image3" android:background="@drawable/avatar_bg2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:adjustViewBounds="true" android:layout_centerInParent="true" android:clipToOutline="true" />
    </RelativeLayout>
</RelativeLayout>
