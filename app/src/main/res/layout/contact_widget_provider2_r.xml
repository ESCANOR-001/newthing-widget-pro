<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/AppTheme.Overlay"
    android:id="@+id/root_view"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView
        android:id="@+id/background_image_improve"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:src="@drawable/rounded_bg_20_rect"
        android:layout_centerInParent="true" />

    <ImageView
        android:id="@+id/background_image_improve_light"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:src="@drawable/rounded_bg_20_rect_light"
        android:layout_centerInParent="true" />

    <ImageView
        android:id="@+id/background_border"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:src="@drawable/rounded_with_border"
        android:layout_centerInParent="true" />

    <LinearLayout
        android:orientation="vertical"
        android:padding="10.0dip"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:weightSum="2.0">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:weightSum="2.0"
            android:layout_weight="1.0">

            <RelativeLayout
                android:gravity="center"
                android:id="@+id/top_contact"
                android:padding="5.0dip"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_weight="2.0">

                <ImageView
                    android:id="@+id/bg"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:src="@drawable/gradiant_bg"
                    android:layout_centerInParent="true" />

                <ImageView
                    android:id="@+id/name_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true" />
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:weightSum="2.0"
            android:layout_weight="1.0">

            <RelativeLayout
                android:id="@+id/main2"
                android:padding="5.0dip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true">

                <ImageView
                    android:id="@+id/call_icon"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_centerInParent="true"
                    android:background="@drawable/red_bg" />

                <ImageView
                    android:id="@+id/call_icon_button"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:src="@drawable/call_icon"
                    android:layout_centerInParent="true" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/main"
                android:padding="5.0dip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true">

                <ImageView
                    android:id="@+id/message"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_centerInParent="true"
                    android:background="@drawable/red_bg" />

                <ImageView
                    android:id="@+id/message_icon"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_centerInParent="true"
                    android:src="@drawable/message_icon" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

