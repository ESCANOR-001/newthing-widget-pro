<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:theme="@style/AppTheme.Overlay" android:id="@+id/root_view" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView android:id="@+id/background_image_improve" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="fill_parent" android:src="@drawable/rounded_bg_20" android:layout_centerInParent="true" />
    <ImageView android:id="@+id/background_image_improve_light" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="fill_parent" android:src="@drawable/rounded_bg_20_light_r" android:layout_centerInParent="true" />
    <ImageView android:id="@+id/background_image" android:layout_width="fill_parent" android:layout_height="fill_parent" android:src="@drawable/rounder_glow_bg8_36" android:layout_centerInParent="true" />
    <ImageView android:id="@+id/background_border" android:layout_width="fill_parent" android:layout_height="fill_parent" android:src="@drawable/rounded_for_all_with_border" android:layout_centerInParent="true" />
    <RelativeLayout android:id="@+id/avatar_image_bg" android:layout_width="fill_parent" android:layout_height="fill_parent">
        <ImageView android:id="@+id/avatar_image" android:background="@drawable/avatar_bg2" android:layout_width="fill_parent" android:layout_height="fill_parent" android:scaleType="centerCrop" android:adjustViewBounds="true" android:layout_centerInParent="true" android:clipToOutline="true" />
    </RelativeLayout>
    <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:layout_centerInParent="true">
        <ImageView android:id="@+id/call_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/call_icon_4" />
    </RelativeLayout>
</RelativeLayout>

